    "onSurface": {
      "$type": "color",
      "$value": "#ffffffff"
    },
    "onSurfaceVariant": {
      "$type": "color",
      "$value": "#cac4d0ff"
    },
    "outline": {
      "$type": "color",
      "$value": "#948f9aff"
    },
    "outlineVariant": {
      "$type": "color",
      "$value": "#615d67ff"
    },
    "error": {
      "$type": "color",
      "$value": "#ee675cff"
    },
    "onError": {
      "$type": "color",
      "$value": "#000000ff"
    }
