  "type": {
    "displaySmall": {
      "$type": "typography",
      "$value": {
        "fontFamily": "FontListFontFamily(fonts=[Font(familyName=\"DeviceFontFamilyName(name=roboto-flex)",
        "fontSize": 24,
        "fontWeight": 550,
        "letterSpacing": 0.2,
        "lineHeight": 26
      }
    },
    "titleLarge": {
      "$type": "typography",
      "$value": {
        "fontFamily": "FontListFontFamily(fonts=[Font(familyName=\"DeviceFontFamilyName(name=roboto-flex)",
        "fontSize": 18,
        "fontWeight": 500,
        "letterSpacing": 0.2,
        "lineHeight": 20
      }
    },
    "titleMedium": {
      "$type": "typography",
      "$value": {
        "fontFamily": "FontListFontFamily(fonts=[Font(familyName=\"DeviceFontFamilyName(name=roboto-flex)",
        "fontSize": 16,
        "fontWeight": 550,
        "letterSpacing": 0.4,
        "lineHeight": 18
      }
    },
    "bodyLarge": {
      "$type": "typography",
      "$value": {
        "fontFamily": "FontListFontFamily(fonts=[Font(familyName=\"DeviceFontFamilyName(name=roboto-flex)",
        "fontSize": 16,
        "fontWeight": 450,
        "letterSpacing": 0.4,
        "lineHeight": 18
      }
    },
    "bodyMedium": {
      "$type": "typography",
      "$value": {
        "fontFamily": "FontListFontFamily(fonts=[Font(familyName=\"DeviceFontFamilyName(name=roboto-flex)",
        "fontSize": 14,
        "fontWeight": 450,
        "letterSpacing": 0.4,
        "lineHeight": 16
      }
    },
    "labelSmall": {
      "$type": "typography",
      "$value": {
        "fontFamily": "FontListFontFamily(fonts=[Font(familyName=\"DeviceFontFamilyName(name=roboto-flex)",
