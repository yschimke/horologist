{
  "$schema": "https://github.com/yschimke/design-parity/schema/dtcg-tokens.schema.json",
  "color": {
    "primary": {
      "$type": "color",
      "$value": "#d0bcffff"
    },
    "primaryDim": {
      "$type": "color",
      "$value": "#d0bcffff"
    },
    "primaryContainer": {
      "$type": "color",
      "$value": "#9a82dbff"
    },
    "onPrimary": {
      "$type": "color",
      "$value": "#303133ff"
